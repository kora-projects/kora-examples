<configuration debug="false">
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%cyan(%d{HH:mm:ss.SSS}) %highlight(%-5level) [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC" class="io.koraframework.logging.logback.KoraAsyncAppender">
        <appender-ref ref="STDOUT"/>
    </appender>

    <root level="WARN">
        <appender-ref ref="ASYNC"/>
    </root>

    <logger level="INFO" name="io.koraframework"/>

    <logger level="DEBUG" name="io.koraframework.kotlin.example"/>

    <logger level="TRACE" name="io.koraframework.telemetry"/>
    <logger level="TRACE" name="io.koraframework.micrometer"/>
    <logger level="TRACE" name="io.koraframework.logging"/>

    <logger level="DEBUG" name="org.testcontainers.containers"/>
    <logger level="DEBUG" name="io.goodforgod.testcontainers.extensions"/>
</configuration>
